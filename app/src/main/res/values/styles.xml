<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">#8253F5</item>
        <item name="android:windowBackground">#F8F7FC</item>
    </style>
    <style name="Theme.LinkGrab.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#F8F7FC</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>
</resources>
